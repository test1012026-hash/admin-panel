# Admin panel
VITE_API_URL=
# When empty, Vite proxies /api → http://localhost:4000

# Server (.env in server/)
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=ChangeMeNow12
# ADMIN_APP_URL=http://localhost:5174
# JWT_SECRET=...
# MONGODB_URI=...
#
# Admin SSO (Google / Microsoft / Yahoo) — configure on server .env
# Register each admin domain callback on ONE OAuth client per provider:
#   http://localhost:5174/api/admin/auth/oauth/google/callback
#   https://your-admin-domain/api/admin/auth/oauth/google/callback
# (same pattern for microsoft + yahoo)
# ADMIN_OAUTH_RETURN_ORIGINS=http://localhost:5174,https://your-admin-domain
# ADMIN_OAUTH_GOOGLE_CLIENT_ID=...
# ADMIN_OAUTH_GOOGLE_CLIENT_SECRET=...
# ADMIN_OAUTH_MICROSOFT_CLIENT_ID=...
# ADMIN_OAUTH_MICROSOFT_CLIENT_SECRET=...
# ADMIN_OAUTH_YAHOO_CLIENT_ID=...
# ADMIN_OAUTH_YAHOO_CLIENT_SECRET=...
